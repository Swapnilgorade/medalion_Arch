def extract_visual_type(visual_json):

    visual = visual_json.get(
        "visual",
        {}
    )

    if isinstance(visual, dict):

        value = visual.get(
            "visualType"
        )

        if value:
            return readable_visual_type(
                value
            )

        value = visual.get(
            "type"
        )

        if value:
            return readable_visual_type(
                value
            )

    values = recursive_find(
        visual_json,
        "visualType"
    )

    if values:

        return readable_visual_type(
            values[0]
        )

    return "Unknown"


# ============================================================
# VISUAL TITLE
# ============================================================

def extract_visual_title(visual_json):

    titles = recursive_find(
        visual_json,
        "title"
    )

    for title in titles:

        if not isinstance(title, dict):
            continue

        text_obj = title.get(
            "text"
        )

        if isinstance(text_obj, dict):

            expr = text_obj.get(
                "expr"
            )

            if isinstance(expr, dict):

                literal = expr.get(
                    "Literal"
                )

                if isinstance(
                    literal,
                    dict
                ):

                    value = literal.get(
                        "Value"
                    )

                    if value:

                        value = str(
                            value
                        ).strip(
                            "'\""
                        )

                        if value:
                            return value

            value = text_obj.get(
                "value"
            )

            if value:
                return clean_text(
                    value
                )

        if isinstance(
            text_obj,
            str
        ):

            return text_obj

    return ""


