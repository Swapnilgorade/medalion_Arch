            visual_json
        )

        # ----------------------------------------------------
        # Interaction
        # ----------------------------------------------------

        interaction_info = (
            extract_interaction_info(
                visual_json
            )
        )

        # ----------------------------------------------------
        # Build record
        # ----------------------------------------------------

        record = {

            "Visual #":
                visual_number,

            "Visual":
                visual_name,

            "Visual Type":
                visual_type,

            "Chart / Visual Title":
                title,

            "Technical Visual ID":
                visual_folder.name,

            "Tables Used":
                join_unique(
                    all_tables
                ),

            "X Axis / Category":
                join_unique(
                    x_axis
                ),

