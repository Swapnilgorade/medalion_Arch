def extract_query_refs(visual_json):

    refs = []

    def walk(obj):

        if isinstance(
            obj,
            dict
        ):

            if "queryRef" in obj:

                refs.append(
                    clean_text(
                        obj["queryRef"]
                    )
                )

            if "Name" in obj:

                name = obj.get(
                    "Name"
                )

                if isinstance(
                    name,
                    str
                ):

                    refs.append(
                        name
                    )

            for value in obj.values():
                walk(value)

        elif isinstance(
            obj,
            list
        ):

            for item in obj:
                walk(item)

    walk(
        visual_json
    )

    return unique_list(
        refs
    )


# ============================================================
# EXTRACT FIELDS BY ROLE
# ============================================================

def extract_role_fields(
    visual_json
):

    role_data = {}

    # --------------------------------------------------------
    # First attempt: projections
    # --------------------------------------------------------

    projections = extract_projections(
        visual_json
    )

    for item in projections:

        role = readable_role(
            item["Role"]
        )

        values = role_data.setdefault(
            role,
            []
        )

        if item["Display Name"]:
            values.append(
                item["Display Name"]
            )

        elif item["Query Ref"]:
            values.append(
                item["Query Ref"]
            )

    # --------------------------------------------------------
    # Search objects containing queryRef
    # --------------------------------------------------------

    def walk(obj):

        if isinstance(
            obj,
            dict
        ):

            if "queryRef" in obj:

                ref = clean_text(
                    obj.get(
                        "queryRef"
                    )
                )

                parent_role = (
                    obj.get(
                        "role"
                    )
                    or
                    obj.get(
                        "Role"
                    )
                    or
                    ""
                )

                if parent_role and ref:

                    role = readable_role(
                        parent_role
                    )

                    role_data.setdefault(
                        role,
                        []
                    ).append(
                        ref
                    )

            for value in obj.values():
                walk(value)

        elif isinstance(
            obj,
            list
        ):

            for item in obj:
                walk(item)

    walk(
        visual_json
    )

    # Remove duplicates
    for role in list(
        role_data.keys()
    ):

        role_data[role] = unique_list(
            role_data[role]
        )

    return role_data


