# ============================================================
# FORMAT POWER BI FIELD
# ============================================================

def format_field(
    table="",
    column="",
    measure="",
    aggregation=""
):

    table = normalize_name(table)
    column = normalize_name(column)
    measure = normalize_name(measure)
    aggregation = normalize_name(aggregation)

    if measure:

        if table:
            result = f"{table}[{measure}]"
        else:
            result = measure

    elif column:

        if table:
            result = f"{table}[{column}]"
        else:
            result = column

    else:

        result = table

    if aggregation:

        result += f" ({aggregation})"

    return result


# ============================================================
# EXTRACT FIELD FROM OBJECT
# ============================================================

def parse_field_object(obj):

    results = []

    if not isinstance(
        obj,
        dict
    ):
        return results

    # --------------------------------------------------------
    # Direct Entity / Property
    # --------------------------------------------------------

    entity = obj.get(
        "Entity"
    )

    property_name = obj.get(
        "Property"
    )

    if entity or property_name:

        results.append({
            "Table":
                clean_text(entity),

            "Column":
                clean_text(property_name),

            "Measure":
                "",

            "Aggregation":
                "",

            "Field":
                format_field(
                    entity,
                    property_name
                ),

            "Field Type":
                "Column"
        })

    # --------------------------------------------------------
    # Measure object
    # --------------------------------------------------------

    measure = obj.get(
        "Measure"
    )

    if isinstance(
        measure,
        dict
    ):

        entity = measure.get(
            "Entity",
            ""
        )

        name = (
            measure.get("Property")
            or
            measure.get("Name")
            or
            measure.get("Measure")
            or
            ""
        )

        results.append({

            "Table":
                clean_text(entity),

            "Column":
                "",

            "Measure":
                clean_text(name),

            "Aggregation":
                "",

            "Field":
                format_field(
                    entity,
                    "",
                    name
                ),

            "Field Type":
                "Measure"
        })

    # --------------------------------------------------------
    # Aggregation
    # --------------------------------------------------------

    aggregation = (
        obj.get("Aggregation")
        or
        obj.get("aggregation")
        or
        ""
    )

    if aggregation:

        aggregation = clean_text(
            aggregation
        )

        # Attach aggregation to
        # an existing field
        if results:

            for item in results:
                item["Aggregation"] = (
                    aggregation
                )

                item["Field"] = format_field(
                    item["Table"],
                    item["Column"],
                    item["Measure"],
                    aggregation
                )

    return results


# ============================================================
# EXTRACT ALL FIELDS
# ============================================================

def extract_all_fields(visual_json):

    fields = []

    def walk(obj):

        if isinstance(
            obj,
            dict
        ):

            parsed = parse_field_object(
                obj
            )

            fields.extend(
                parsed
            )

            for value in obj.values():
                walk(value)

        elif isinstance(
            obj,
            list
        ):

            for item in obj:
                walk(item)

    walk(
        visual_json
    )

    # Unique
    unique = []
    seen = set()

    for field in fields:

        key = (
            field["Table"],
            field["Column"],
            field["Measure"],
            field["Aggregation"],
            field["Field Type"]
        )

        if key in seen:
            continue

        seen.add(
            key
        )

        unique.append(
            field
        )

    return unique


# ============================================================
# EXTRACT PROJECTIONS / AXIS ROLES
# ============================================================

def extract_projections(visual_json):

    results = []

    projections = recursive_find(
        visual_json,
        "projections"
    )

    for projection in projections:

        if not isinstance(
            projection,
            dict
        ):
            continue

        for role, items in projection.items():

            if not isinstance(
                items,
                list
            ):
                continue

            for item in items:

                if not isinstance(
                    item,
                    dict
                ):
                    continue

                query_ref = (
                    item.get(
                        "queryRef"
                    )
                    or
                    item.get(
                        "queryName"
                    )
                    or
                    ""
                )

                display_name = (
                    item.get(
                        "displayName"
                    )
                    or
                    ""
                )

                results.append({

                    "Role":
                        normalize_name(
                            role
                        ),

                    "Query Ref":
                        normalize_name(
                            query_ref
                        ),

                    "Display Name":
                        normalize_name(
                            display_name
                        ),

                    "Projection":
                        safe_json(
                            item
                        )
                })

    return results


