                    role_values
                )

            elif role == "Columns":

                columns.extend(
                    role_values
                )

            elif role == "Details":

                details.extend(
                    role_values
                )

            elif role == "Small Multiples":

                small_multiples.extend(
                    role_values
                )

        # ----------------------------------------------------
