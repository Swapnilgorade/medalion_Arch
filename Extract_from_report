def load_json(file_path):
    try:
        with open(file_path, "r", encoding="utf-8-sig") as f:
            return json.load(f)
    except Exception as e:
        print(f"[WARNING] Could not read: {file_path}")
        print(e)
        return {}


def clean_text(value):
    if value is None:
        return ""

    if isinstance(value, bool):
        return str(value)

    if isinstance(value, (dict, list)):
        try:
            return json.dumps(
                value,
                ensure_ascii=False
            )
        except Exception:
            return str(value)

    return str(value).strip()


def normalize_name(value):
    """
    Convert technical Power BI names into readable names.
    """
    if value is None:
        return ""

    value = str(value)

    value = value.replace(
        "\n",
        " "
    ).replace(
        "\r",
        " "
    )

    value = re.sub(
        r"\s+",
        " ",
        value
    )

    return value.strip()


def recursive_find(obj, key_name):
    results = []

    if isinstance(obj, dict):

        for key, value in obj.items():

            if key.lower() == key_name.lower():
                results.append(value)

            results.extend(
                recursive_find(
                    value,
                    key_name
                )
            )

    elif isinstance(obj, list):

        for item in obj:

            results.extend(
                recursive_find(
                    item,
                    key_name
                )
            )

    return results


def recursive_find_all_keys(obj, key_names):
    """
    Search multiple keys at once.
    """
    results = []

    key_names = {
        x.lower()
        for x in key_names
    }

    def walk(value):

        if isinstance(value, dict):

            for key, child in value.items():

                if str(key).lower() in key_names:

                    results.append(
                        (key, child)
                    )

                walk(child)

        elif isinstance(value, list):

            for item in value:
                walk(item)

    walk(obj)

    return results


def unique_list(values):

    output = []
    seen = set()

    for value in values:

        value = clean_text(value)

        if not value:
            continue

        if value not in seen:

            seen.add(value)
            output.append(value)

    return output


def join_unique(values, separator=" | "):

    return separator.join(
        unique_list(values)
    )


def safe_json(value):

    try:
        return json.dumps(
            value,
            ensure_ascii=False
        )
    except Exception:
        return str(value)


