def extract_query_objects(
    visual_json
):

    query_objects = []

    keys = [
        "query",
        "prototypeQuery",
        "semanticQueryDataShapeCommand",
        "queryState",
        "commands"
    ]

    for key in keys:

        values = recursive_find(
            visual_json,
            key
        )

        for value in values:

            if value:

                query_objects.append(
                    value
                )

    return query_objects


# ============================================================
# READABLE QUERY
# ============================================================

def extract_readable_query(
    visual_json
):

    objects = extract_query_objects(
        visual_json
    )

    if not objects:
        return ""

    lines = []

    for obj in objects:

        if isinstance(
            obj,
            dict
        ):

            selects = obj.get(
                "Select"
            )

            if isinstance(
                selects,
                list
            ):

                for select in selects:

                    if not isinstance(
                        select,
                        dict
                    ):
                        continue

                    name = (
                        select.get(
                            "Name"
                        )
                        or
                        select.get(
                            "queryRef"
                        )
                        or
                        ""
                    )

                    expr = select.get(
                        "Column"
                    )

                    if isinstance(
                        expr,
                        dict
                    ):

                        source = expr.get(
                            "Source"
                        )

                        property_name = (
                            expr.get(
                                "Property"
                            )
                            or
                            expr.get(
                                "Name"
                            )
                        )

                        if property_name:

                            lines.append(
                                str(
                                    property_name
                                )
                            )

                    elif name:

                        lines.append(
                            str(name)
                        )

    return join_unique(
        lines
    )


# ============================================================
# FILTER EXTRACTION
# ============================================================

def extract_filters(
    obj
):

    filters = []

    values = (
        recursive_find(
            obj,
            "filter"
        )
        +
        recursive_find(
            obj,
            "filters"
        )
    )

    for value in values:

        if not value:
            continue

        if isinstance(
            value,
            (dict, list)
        ):

            try:
                text = json.dumps(
                    value,
                    ensure_ascii=False
                )
            except Exception:
                text = str(value)

        else:

            text = str(
                value
            )

        text = text.strip()

        if text:
            filters.append(
                text
            )

    return join_unique(
        filters,
        separator="\n"
    )


