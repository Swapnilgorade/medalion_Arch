def extract_page_name(
    page_folder
):

    page_json_path = (
        page_folder /
        "page.json"
    )

    if page_json_path.exists():

        data = load_json(
            page_json_path
        )

        for key in [
            "displayName",
            "name",
            "pageName"
        ]:

            value = data.get(
                key
            )

            if value:
                return clean_text(
                    value
                )

        values = recursive_find(
            data,
            "displayName"
        )

        if values:

            return clean_text(
                values[0]
            )

    return page_folder.name


# ============================================================
# PAGE VISUAL ORDER
# ============================================================

def get_visual_folders(
    visuals_folder
):

    visual_folders = [
        v
        for v in visuals_folder.iterdir()
        if v.is_dir()
    ]

    # PBIR does not always provide a
    # simple human-readable ordering.
    #
    # Position is therefore used where
    # available.

    sortable = []

    for folder in visual_folders:

        visual_json_path = (
            folder /
            "visual.json"
        )

        data = {}

        if visual_json_path.exists():
            data = load_json(
                visual_json_path
            )

        position = extract_position(
            data
        )

        y = position.get(
            "Y",
            999999
        )

        x = position.get(
            "X",
            999999
        )

        try:
            y = float(y)
        except Exception:
            y = 999999

        try:
            x = float(x)
        except Exception:
            x = 999999

        sortable.append(
            (
                y,
                x,
                folder
            )
        )

    sortable.sort(
        key=lambda x: (
            x[0],
            x[1]
        )
    )

    return [
        x[2]
        for x in sortable
    ]


# ============================================================
# PAGE SUMMARY
# ============================================================

def create_page_summary(
    page_name,
    page_number,
    page_filters,
    visual_records
):

    visual_count = len(
        visual_records
    )

    type_counts = {}

    for row in visual_records:

        visual_type = row.get(
            "Visual Type",
            "Unknown"
        )

        type_counts[
            visual_type
        ] = (
            type_counts.get(
                visual_type,
                0
            ) + 1
        )

    type_summary = join_unique(
        [
            f"{k}: {v}"
            for k, v
            in type_counts.items()
        ],
        separator=" | "
    )

    return {

        "Page Number":
            page_number,

        "Page Name":
            page_name,

        "Visual Count":
            visual_count,

        "Visual Types":
            type_summary,

        "Page Filters":
            page_filters
    }


# ============================================================
# EXTRACT ONE PAGE
# ============================================================

def extract_page(
    page_folder,
    page_number
):

    page_name = extract_page_name(
        page_folder
    )

    page_json_path = (
        page_folder /
        "page.json"
    )

    if page_json_path.exists():

        page_json = load_json(
            page_json_path
        )

    else:

        page_json = {}

    page_filters = extract_filters(
        page_json
    )

    visuals_folder = (
        page_folder /
        "visuals"
    )

    visual_records = []

    if not visuals_folder.exists():

        return (
            page_name,
            page_filters,
            visual_records
        )

    visual_folders = get_visual_folders(
        visuals_folder
    )

    for visual_number, visual_folder in enumerate(
        visual_folders,
        start=1
    ):

        visual_json_path = (
            visual_folder /
            "visual.json"
        )

        if not visual_json_path.exists():
            continue

        visual_json = load_json(
            visual_json_path
        )

        visual_type = extract_visual_type(
            visual_json
        )

        title = extract_visual_title(
            visual_json
        )

        visual_name = generate_visual_name(
            visual_number,
            visual_type,
            title
        )

        position = extract_position(
            visual_json
        )

        role_fields = extract_role_fields(
            visual_json
        )

        fields = extract_all_fields(
            visual_json
        )

        # ----------------------------------------------------
        # General field list
        # ----------------------------------------------------

        all_columns = []
        all_measures = []
        all_tables = []

        for field in fields:

            if field["Table"]:
                all_tables.append(
                    field["Table"]
                )

            if field["Column"]:
                all_columns.append(
                    format_field(
                        field["Table"],
                        field["Column"],
                        "",
                        field["Aggregation"]
                    )
                )

            if field["Measure"]:
                all_measures.append(
                    format_field(
                        field["Table"],
                        "",
                        field["Measure"],
                        field["Aggregation"]
                    )
                )

        # ----------------------------------------------------
        # Role-specific fields
        # ----------------------------------------------------

        x_axis = []

        y_axis = []

        values = []

        legend = []

        tooltip = []

        rows = []

        columns = []

