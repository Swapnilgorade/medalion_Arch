            visual_json
        )

        # ----------------------------------------------------
        # Query text
        # ----------------------------------------------------

        readable_query = extract_readable_query(
            visual_json
        )

        raw_query = ""

        query_objects = extract_query_objects(
            visual_json
        )

        if query_objects:

            raw_query = "\n".join(
                [
