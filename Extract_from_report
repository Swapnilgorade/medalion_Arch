# ============================================================
# REPORT DISCOVERY
# ============================================================

def find_report_folder(
    pbip_folder
):

    pbip_folder = Path(
        pbip_folder
    )

    report_folders = list(
        pbip_folder.glob(
            "*.Report"
        )
    )

    if not report_folders:

        raise FileNotFoundError(
            "No *.Report folder found."
        )

    return report_folders[0]


# ============================================================
# EXTRACT REPORT
# ============================================================

def extract_report(
    pbip_folder
):

    pbip_folder = Path(
        pbip_folder
    )

    report_folder = find_report_folder(
        pbip_folder
    )

    print(
        f"\nReport Folder:\n{report_folder}"
    )

    definition_folder = (
        report_folder /
        "definition"
    )

    if not definition_folder.exists():

        raise FileNotFoundError(
            "definition folder not found. "
            "Make sure Enhanced PBIR is enabled."
        )

    report_json_path = (
        definition_folder /
        "report.json"
    )

    report_json = {}

    if report_json_path.exists():

        report_json = load_json(
            report_json_path
        )

    report_filters = extract_filters(
        report_json
    )

    pages_folder = (
        definition_folder /
        "pages"
    )

    if not pages_folder.exists():

        raise FileNotFoundError(
            "definition/pages folder not found."
        )

    page_folders = [
        p
        for p in pages_folder.iterdir()
        if p.is_dir()
    ]

    print(
        f"Pages found: {len(page_folders)}"
    )

    page_results = []

    all_visuals = []

    for page_number, page_folder in enumerate(
        page_folders,
        start=1
    ):

        print(
            f"\nProcessing Page {page_number}: "
            f"{page_folder.name}"
        )

        (
            page_name,
            page_filters,
            visual_records
        ) = extract_page(
            page_folder,
            page_number
        )

        print(
            f"   Page Name: {page_name}"
        )

        print(
            f"   Visuals: "
            f"{len(visual_records)}"
        )

        page_summary = create_page_summary(
            page_name,
            page_number,
            page_filters,
            visual_records
        )

        page_results.append(
            page_summary
        )

        for record in visual_records:

            record["Page #"] = (
                page_number
            )

            record["Page Name"] = (
                page_name
            )

            all_visuals.append(
                record
            )

    return {

        "report_folder":
            report_folder,

        "report_filters":
            report_filters,

        "pages":
            page_results,

        "visuals":
            all_visuals
    }


