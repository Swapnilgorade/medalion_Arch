def readable_visual_type(value):

    value = clean_text(value)

    if not value:
        return "Unknown"

    if value in VISUAL_TYPE_MAP:
        return VISUAL_TYPE_MAP[value]

    # Convert camelCase to readable text
    value = re.sub(
        r"(?<!^)([A-Z])",
        r" \1",
        value
    )

    return value.title()


