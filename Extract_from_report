def format_worksheet(
    ws
):

    # Freeze top row
    ws.freeze_panes = "A2"

    # Filter
    if ws.max_row > 1:
        ws.auto_filter.ref = ws.dimensions

    # Header
    for cell in ws[1]:

        cell.font = Font(
            bold=True
        )

        cell.alignment = Alignment(
            horizontal="center",
            vertical="center",
            wrap_text=True
        )

    # Body
    for row in ws.iter_rows(
        min_row=2
    ):

        for cell in row:

            cell.alignment = Alignment(
                vertical="top",
                wrap_text=True
            )

    # Width
    for column_cells in ws.columns:

        max_length = 0

        column_letter = (
            get_column_letter(
                column_cells[0].column
            )
        )

        for cell in column_cells:

            try:

                value_length = len(
                    str(
                        cell.value
                        if cell.value is not None
                        else ""
                    )
                )

                max_length = max(
                    max_length,
                    value_length
                )

            except Exception:
                pass

        # Keep Excel usable
        width = min(
            max(
                max_length + 2,
                12
            ),
            45
        )

        ws.column_dimensions[
            column_letter
        ].width = width


def safe_sheet_name(
    name
):

    # Excel restrictions
    name = re.sub(
        r'[\\/*?:\[\]]',
        "_",
        name
    )

    name = name.strip()

    if not name:
        name = "Page"

    # Max 31 chars
    return name[:31]


def unique_sheet_name(
    base_name,
    existing
):

    base_name = safe_sheet_name(
        base_name
    )

    if base_name not in existing:
        return base_name

    counter = 2

    while True:

        suffix = f"_{counter}"

        candidate = (
            base_name[:31-len(suffix)]
            + suffix
        )

        if candidate not in existing:
            return candidate

        counter += 1


# ============================================================
# WRITE EXCEL
# ============================================================

def write_excel(
    data,
    output_file
):

    with pd.ExcelWriter(
        output_file,
        engine="openpyxl"
    ) as writer:

        # ====================================================
        # REPORT SUMMARY
        # ====================================================

        report_folder = data[
            "report_folder"
        ]

        report_summary = pd.DataFrame([{

            "Report Project":
                report_folder.parent.name,

            "Report Folder":
                report_folder.name,

            "Report Path":
                str(report_folder),

            "Number of Pages":
                len(data["pages"]),

            "Total Visuals":
                len(data["visuals"]),

            "Report Filters":
                data["report_filters"]

        }])

        report_summary.to_excel(
            writer,
            sheet_name="Report Summary",
            index=False
        )

        # ====================================================
        # PAGE SUMMARY
        # ====================================================

        page_summary = pd.DataFrame(
            data["pages"]
        )

        page_summary.to_excel(
            writer,
            sheet_name="All Pages",
            index=False
        )

        # ====================================================
        # ALL VISUALS
        # ====================================================

        all_visuals = pd.DataFrame(
            data["visuals"]
        )

        # Put Page information first
        preferred_columns = [

            "Page #",
            "Page Name",
            "Visual #",
            "Visual",
            "Visual Type",
            "Chart / Visual Title",
            "Technical Visual ID",

            "Tables Used",

            "X Axis / Category",
            "Y Axis",
            "Values / Measures",

            "Legend",
            "Tooltips",

            "Rows",
            "Columns",
            "Details",
            "Small Multiples",

            "All Columns Used",
            "All Measures Used",

            "Query References",
            "Readable Query",

            "Visual Filters",
            "Page Filters",

            "Sort",

            "X",
            "Y",
            "Width",
            "Height",
            "Z Order",

            "Interaction / Configuration",

            "Raw Query / Technical Details"
        ]

        available_columns = [
            c
            for c in preferred_columns
            if c in all_visuals.columns
        ]

        all_visuals = all_visuals[
            available_columns
        ]

        all_visuals.to_excel(
            writer,
            sheet_name="All Visuals",
            index=False
        )

        # ====================================================
        # ONE SHEET PER POWER BI PAGE
        # ====================================================

        existing_sheet_names = set()

        existing_sheet_names.add(
            "Report Summary"
        )

        existing_sheet_names.add(
            "All Pages"
        )

        existing_sheet_names.add(
            "All Visuals"
        )

        page_groups = (
            all_visuals.groupby(
                [
                    "Page #",
                    "Page Name"
                ],
                sort=False
            )
        )

        for (
            page_key,
            page_df
        ) in page_groups:

            page_number, page_name = (
                page_key
            )

            sheet_base = (
                f"Page {page_number}"
            )

            sheet_name = unique_sheet_name(
                sheet_base,
                existing_sheet_names
            )

            existing_sheet_names.add(
                sheet_name
            )

            # Remove page-specific
            # duplicate information
            page_df = page_df.drop(
                columns=[
                    "Page #",
                    "Page Name"
                ],
                errors="ignore"
            )

            page_df.to_excel(
                writer,
                sheet_name=sheet_name,
                index=False
            )

    # ========================================================
    # POST FORMAT
    # ========================================================

    wb = load_workbook(
        output_file
    )

    for ws in wb.worksheets:

        format_worksheet(
            ws
        )

        # Increase row height
        # for readable multiline fields
        for row in range(
            2,
            ws.max_row + 1
        ):

            ws.row_dimensions[
                row
            ].height = 45

    wb.save(
        output_file
    )

    print(
        "\n=========================================="
    )

    print(
        "POWER BI ANALYSIS CREATED"
    )

    print(
        "=========================================="
    )

    print(
        f"Output:\n{output_file}"
    )

    print(
        "=========================================="
    )


